<head>
    <title>The Books I've Read</title>
    <meta charset="utf-8" lang="en">
    <link href="styles.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Outfit:wght@100..900&family=Roboto+Slab:wght@100..900&display=swap" rel="stylesheet">
<body>
    <%-include ("header.ejs")%>
    <div id="nav">
        <div id="intro" class="common_box">
            <h3 class='libre-baskerville-regular' > A perfect spot to log your book reviews!</h3>
        </div>
        <div class="add">
            <form method="get" action="/search">
                <input type="submit" class="btn shadow roboto-slab-heading" id="add_btn" value="Add new book" />
            </form>
        </div>
        <%if (locals.books){%>
            <%if (books.length!=0){%>
                <div class="delete">
                    <form method="get" action="/delete">
                        <input type="submit" class="btn shadow roboto-slab-heading" id="delete_btn" value="Delete books"/>
                    </form>
                </div>
            <%}%>
        <%}%>
    </div>
    <div class="book_list">
        <%if (locals.books){%>
            <%if (books.length!=0){%>
                <% books.forEach((book)=>{%>
                    <div class="book">
                    <div class="edit">
                        <form method="get" action="/review">
                            <input type="submit" class="btn shadow edit_btn" id="edit_btn<%=book["olid"]%>"  value="">
                            <input type="hidden" name="olid" value="<%=book["olid"]%>"/>
                        </form>
                    </div>
                    <div class="book_desc">
                        <h1 class='roboto-slab-heading'><%=book["name"] %></h1>
                        <h2 class="book_auth roboto-slab-heading" >- <%=book["authors"]%></h2>
                        <img src=<%=book["img_url"]%> loading="lazy" >
                        <h3 class="outfit-body"><%=book["review"]%></h3>
                        <div class="rating">
                            <h2 class="roboto-slab-heading">Rating out of 5: <%=book["rating"]%>❤️</h2>
                        </div>
                    </div>
                </div>
                <%})%>
            <%}%>
        <%}%>
    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="script.js"></script>
</body>
