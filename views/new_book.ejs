<head>
    <title>New Book Entry</title>
    <meta charset="utf-8">
</head>
<body>
    <div>
        <form method="post" action="/search">
            <div>
                <label>Enter book name:</label>
                <input type="text" name="book_name" <% if (locals.title){%> value="<%=title%>" <% } %>/>
                <input type="submit" value="submit"/>
            </div>
        </form>
    </div>
    <div>
        <%if (locals.error){%>
            <div>
                <h1><%=error%></h1>
            </div>
        <% }else if (locals.docs){%>
            <div>
                <%docs.forEach((doc)=>{%>
                    <h1><%doc.title%></h1>
                    <img src=<%=api_img%>+doc.cover_edition_key>
                    <%(doc.author_name).forEach((author)=>{%>
                        <h3><%author%></h3>
                    <%})%>
                    <form method="post" action="/review">
                        <input type="hidden" name="olid" value="<%=doc.cover_edition_key%>">
                        <input type="hidden" name="author_name" value="<%=doc.author_name%>">
                        <input type="hidden" name="title" value="<%=doc.title%>">
                        <input type="submit"  value="Add this book">
                    </form>
                <%})%>
            </div>
        <%}%>
    </div>

</body>