<head>
    <title>New Book Entry</title>
    <meta charset="utf-8">
    <link href="styles_new_book.css" rel="stylesheet">
</head>
<body>
    <%-include ("header.ejs")%>
    <div id="search-area">
    <div id="search">
        <form method="post" action="/search">
                <h3>Enter book name:</h3>
                <input class="textbox" type="text" name="book_name" <% if (locals.title){%> value="<%=title%>" <% } %>/>
                <input class="btn shadow" id="search_btn" type="submit" value="submit"/>
        </form>
    </div>
    <div id="results">
        <%if (locals.error){%>
            <div>
                <h1><%=error%></h1>
            </div>
        <% }else if (locals.docs){%>
            
                <%docs.forEach((doc)=>{%>
                    <% if (doc["cover_edition_key"] && doc["author_name"]){%>
                        <div>
                            <h1><%=doc.title%></h1>
                            <img src="<%=api_img%><%=doc["cover_edition_key"]%>-M.jpg">
                    
                            <%doc["author_name"].forEach((author)=>{%>
                                <h3><%=author%></h3>
                            <%})%>
                            <form method="get" action="/review">
                                <input type="hidden" name="olid" value="<%=doc["cover_edition_key"]%>">
                                <input type="hidden" name="author_name" value="<%=doc["author_name"]%>">
                                <input type="hidden" name="title" value="<%=doc.title%>">
                                <input type="submit"  value="Add this book">
                            </form>
                        </div>
                    <%}%>
                <%})%>
                
        <%}%>
    </div>
    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="script.js"></script>

</body>