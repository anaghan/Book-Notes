<head>
    <title>Delete book</title>
    <meta charset="utf-8" lang="en">
</head>
<body>
    <div>
        <form action="/delete" method="post">
            <%if (locals.books){%>
                <% books.forEach((book)=>{%>
                    <div>
                        <h1><%=book["name"] %></h1>
                        <img src=<%=book["img_url"]%>>
                        <input type="checkbox" name="book_olid" value="<%=book["olid"]%>">
                    </div>
                <% }) %>
            <%}%>
            <div>
                <input type="submit" value="Delete">
            </div>
        </form>
    </div>
</body>